# Janus Identity Service - Environment Variables
# Ready-to-run example for the SendPulse mailer path (MAILER_PROVIDER=sendpulse).
# Use this instead of .env.example when the host's outbound SMTP ports
# (25/465/587/2525) are firewalled — common on cloud VMs — since SendPulse
# sends over HTTPS instead. See .env.example for the smtp path.

# Server
PORT=8080

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/janus?sslmode=disable

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Dev mode: true = no secret strength checks (local testing only).
# Unset/false (default = production) requires JWT_SECRET and every SERVICE_KEYS entry >= 45 chars.
DEV_ENV=true

# JWT secret (CHANGE IN PRODUCTION! min 45 chars when DEV_ENV is not true)
JWT_SECRET=change-me-jwt-secret-min-45-chars-xxxxxxxxxxx

# Service keys for CRUD operations (comma-separated, min 2 for rotation; each >= 45 chars when DEV_ENV is not true)
SERVICE_KEYS=change-me-service-key-current-min-45-chars-xx,change-me-service-key-previous-min-45-chars-x

# Token TTLs (optional, defaults shown)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=336h    # 14 days
# MAGIC_LINK_TTL=15m
# INVITE_TTL=168h           # 7 days
# RECOVER_TTL=1h

# Rate limiting (optional)
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW=1m

# Account lockout (optional)
# LOCKOUT_THRESHOLD=5
# LOCKOUT_DURATION=15m

# Mailer stub mode (true = log emails to console; false = real delivery).
# false here on purpose — this file demonstrates the real SendPulse path.
MAILER_STUB=false

# Mailer provider: sendpulse (sends over HTTPS, not raw SMTP)
MAILER_PROVIDER=sendpulse

# SMTP — not used by the sendpulse path, left blank on purpose.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# SendPulse (required when MAILER_PROVIDER=sendpulse)
# OAuth client_credentials from SendPulse > Settings > API. These are
# example-shaped values, not real credentials — replace both.
SENDPULSE_USER_ID=sp_id_example0000000000000000
SENDPULSE_SECRET=sp_sk_example000000000000000000000000000000

# From name/address (required when MAILER_STUB=false, any provider)
MAIL_FROM_NAME=Janus
MAIL_FROM_EMAIL=noreply@example.com

# Base URL for links in invite / magic-link / recover emails (required when MAILER_STUB=false)
APP_BASE_URL=https://app.example.com

# Outbox worker (optional, defaults shown)
# MAILER_WORKER_INTERVAL=2s
# MAILER_MAX_ATTEMPTS=5
