# Janus Identity Service - Environment Variables

# Server
PORT=8080

# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/janus?sslmode=disable

# Logging: debug, info, warn, error
LOG_LEVEL=info

# Dev mode: true = no secret strength checks (local testing only).
# Unset/false (default = production) requires JWT_SECRET and every SERVICE_KEYS entry >= 45 chars.
DEV_ENV=true

# JWT secret (CHANGE IN PRODUCTION! min 45 chars when DEV_ENV is not true)
JWT_SECRET=your-secure-secret-here-min-32-chars

# Service keys for CRUD operations (comma-separated, min 2 for rotation; each >= 45 chars when DEV_ENV is not true)
SERVICE_KEYS=your-current-key,your-previous-key

# Token TTLs (optional, defaults shown)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=336h    # 14 days
# MAGIC_LINK_TTL=15m
# INVITE_TTL=168h           # 7 days
# RECOVER_TTL=1h

# Rate limiting (optional)
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW=1m

# Account lockout (optional)
# LOCKOUT_THRESHOLD=5
# LOCKOUT_DURATION=15m

# Mailer stub mode (true = log emails to console)
MAILER_STUB=true
